# Copy to .env and fill in. Never commit .env.

# demo (default): anonymized sample match, no Riot key needed
# live: your real games through the Riot API
RIOT_MODE=demo

# Only for RIOT_MODE=live (dev keys expire every 24h): https://developer.riotgames.com
RIOT_API_KEY=

# Any OpenAI-compatible provider. Optional in the web app: visitors can paste their own key.
LLM_API_KEY=
# LLM_URL=https://api.cohere.ai/compatibility/v1/chat/completions
# LLM_MODEL=command-a-plus-05-2026
# RIOT_REGIONAL=europe   # europe | americas | asia
